{
    "name": "codecomplexity",
    "displayName": "Code Complexity Guard",
    "description": "Offline code complexity analysis for 12 languages: cyclomatic and cognitive complexity, estimated Big-O time and space, plain-language verdicts and concrete optimization suggestions. No AI, no API key, no Python required.",
    "version": "1.0.0",
    "publisher": "Kishan-aicodeguard",
    "author": {
        "name": "Kishan Dewasi"
    },
    "license": "MIT",
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#1e1e2e",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Linters",
        "Programming Languages",
        "Visualization",
        "Education"
    ],
    "keywords": [
        "complexity",
        "big-o",
        "cyclomatic complexity",
        "cognitive complexity",
        "code quality",
        "performance",
        "refactoring",
        "python",
        "java",
        "javascript",
        "typescript",
        "go",
        "rust",
        "c",
        "c++",
        "c#",
        "ruby",
        "php",
        "linter",
        "tree-sitter"
    ],
    "activationEvents": [
        "onLanguage:python",
        "onLanguage:java",
        "onLanguage:javascript",
        "onLanguage:javascriptreact",
        "onLanguage:typescript",
        "onLanguage:typescriptreact",
        "onLanguage:go",
        "onLanguage:rust",
        "onLanguage:c",
        "onLanguage:cpp",
        "onLanguage:csharp",
        "onLanguage:ruby",
        "onLanguage:php",
        "onView:codecomplexity.functionsView",
        "onCommand:codecomplexity.analyzeWorkspace"
    ],
    "main": "./dist/extension.js",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true,
            "description": "Analysis runs entirely inside the extension host on the text of open files. No code is executed, written to disk, or sent anywhere."
        },
        "virtualWorkspaces": true
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/kdewasi/Code_complexity_guard.git"
    },
    "bugs": {
        "url": "https://github.com/kdewasi/Code_complexity_guard/issues"
    },
    "homepage": "https://github.com/kdewasi/Code_complexity_guard#readme",
    "contributes": {
        "commands": [
            {
                "command": "codecomplexity.analyzeFile",
                "title": "Analyze Current File",
                "category": "Complexity Guard",
                "icon": "$(pulse)"
            },
            {
                "command": "codecomplexity.showReport",
                "title": "Open Complexity Report",
                "category": "Complexity Guard",
                "icon": "$(graph)"
            },
            {
                "command": "codecomplexity.analyzeWorkspace",
                "title": "Analyze Whole Workspace",
                "category": "Complexity Guard",
                "icon": "$(search)"
            },
            {
                "command": "codecomplexity.showSuggestionsPanel",
                "title": "Show Suggestions for Function",
                "category": "Complexity Guard"
            },
            {
                "command": "codecomplexity.showBreakdown",
                "title": "Show Complexity Breakdown",
                "category": "Complexity Guard"
            },
            {
                "command": "codecomplexity.ignoreWarning",
                "title": "Ignore This Function",
                "category": "Complexity Guard"
            },
            {
                "command": "codecomplexity.configureThreshold",
                "title": "Configure Thresholds",
                "category": "Complexity Guard",
                "icon": "$(settings-gear)"
            },
            {
                "command": "codecomplexity.toggleCodeLens",
                "title": "Toggle Inline Summaries (CodeLens)",
                "category": "Complexity Guard"
            },
            {
                "command": "codecomplexity.explainMetrics",
                "title": "What Do These Numbers Mean?",
                "category": "Complexity Guard",
                "icon": "$(question)"
            },
            {
                "command": "codecomplexity.refreshView",
                "title": "Refresh",
                "category": "Complexity Guard",
                "icon": "$(refresh)"
            },
            {
                "command": "codecomplexity.reportIssue",
                "title": "Report an Issue",
                "category": "Complexity Guard"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "codecomplexity.showSuggestionsPanel",
                    "when": "false"
                },
                {
                    "command": "codecomplexity.showBreakdown",
                    "when": "false"
                },
                {
                    "command": "codecomplexity.ignoreWarning",
                    "when": "false"
                },
                {
                    "command": "codecomplexity.refreshView",
                    "when": "false"
                }
            ],
            "editor/context": [
                {
                    "command": "codecomplexity.showReport",
                    "group": "z_complexity@1",
                    "when": "codecomplexity.supportedLanguage"
                }
            ],
            "editor/title": [
                {
                    "command": "codecomplexity.showReport",
                    "group": "navigation@50",
                    "when": "codecomplexity.supportedLanguage"
                }
            ],
            "view/title": [
                {
                    "command": "codecomplexity.showReport",
                    "when": "view == codecomplexity.functionsView",
                    "group": "navigation@1"
                },
                {
                    "command": "codecomplexity.analyzeWorkspace",
                    "when": "view == codecomplexity.functionsView",
                    "group": "navigation@2"
                },
                {
                    "command": "codecomplexity.refreshView",
                    "when": "view == codecomplexity.functionsView",
                    "group": "navigation@3"
                },
                {
                    "command": "codecomplexity.explainMetrics",
                    "when": "view == codecomplexity.functionsView",
                    "group": "navigation@4"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "codecomplexity",
                    "title": "Complexity Guard",
                    "icon": "media/activity-icon.svg"
                }
            ]
        },
        "views": {
            "codecomplexity": [
                {
                    "id": "codecomplexity.functionsView",
                    "name": "Functions",
                    "contextualTitle": "Complexity Guard",
                    "icon": "media/activity-icon.svg"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "codecomplexity.functionsView",
                "contents": "Open a file in a supported language (Python, Java, JavaScript, TypeScript, Go, Rust, C, C++, C#, Ruby or PHP) to see every function graded here.\n\n[Open Complexity Report](command:codecomplexity.showReport)\n\n[What do these numbers mean?](command:codecomplexity.explainMetrics)"
            }
        ],
        "configuration": {
            "title": "Complexity Guard",
            "properties": {
                "codecomplexity.enableRealtime": {
                    "type": "boolean",
                    "default": true,
                    "description": "Re-analyze the file automatically while you type (debounced). When off, analysis runs on save and on demand."
                },
                "codecomplexity.analysisDelay": {
                    "type": "number",
                    "default": 400,
                    "minimum": 100,
                    "maximum": 5000,
                    "description": "Milliseconds to wait after the last keystroke before re-analyzing."
                },
                "codecomplexity.warningThreshold": {
                    "type": "number",
                    "default": 8,
                    "minimum": 1,
                    "description": "Cyclomatic complexity above this value marks a function as 'Needs attention' (yellow)."
                },
                "codecomplexity.criticalThreshold": {
                    "type": "number",
                    "default": 15,
                    "minimum": 1,
                    "description": "Cyclomatic complexity above this value marks a function as 'Poor' (red)."
                },
                "codecomplexity.cognitiveWarningThreshold": {
                    "type": "number",
                    "default": 15,
                    "minimum": 1,
                    "description": "Cognitive complexity above this value marks a function as 'Needs attention'."
                },
                "codecomplexity.cognitiveCriticalThreshold": {
                    "type": "number",
                    "default": 25,
                    "minimum": 1,
                    "description": "Cognitive complexity above this value marks a function as 'Poor'."
                },
                "codecomplexity.showCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a one-line summary (grade, complexity, Big-O) above every function."
                },
                "codecomplexity.showDecorations": {
                    "type": "boolean",
                    "default": true,
                    "description": "Color the first line of each function and show a gutter icon according to its grade."
                },
                "codecomplexity.decorateHealthyFunctions": {
                    "type": "boolean",
                    "default": true,
                    "description": "Also mark functions that are in good shape (green). Turn off to only see problems."
                },
                "codecomplexity.showDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "List complexity problems and optimization suggestions in the Problems panel."
                },
                "codecomplexity.maxFileSizeKB": {
                    "type": "number",
                    "default": 1024,
                    "minimum": 16,
                    "description": "Files larger than this (in KB) are skipped to keep the editor responsive."
                },
                "codecomplexity.enabledLanguages": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "python",
                            "java",
                            "javascript",
                            "javascriptreact",
                            "typescript",
                            "typescriptreact",
                            "go",
                            "rust",
                            "c",
                            "cpp",
                            "csharp",
                            "ruby",
                            "php"
                        ]
                    },
                    "default": [
                        "python",
                        "java",
                        "javascript",
                        "javascriptreact",
                        "typescript",
                        "typescriptreact",
                        "go",
                        "rust",
                        "c",
                        "cpp",
                        "csharp",
                        "ruby",
                        "php"
                    ],
                    "description": "Languages that are analyzed. Remove a language to switch the extension off for it."
                },
                "codecomplexity.workspaceExclude": {
                    "type": "string",
                    "default": "**/{node_modules,.git,dist,build,out,target,vendor,venv,.venv,__pycache__,bin,obj}/**",
                    "description": "Glob of files to skip when analyzing the whole workspace."
                },
                "codecomplexity.workspaceMaxFiles": {
                    "type": "number",
                    "default": 1500,
                    "minimum": 10,
                    "description": "Maximum number of files scanned by 'Analyze Whole Workspace'."
                }
            }
        },
        "walkthroughs": [
            {
                "id": "codecomplexity.gettingStarted",
                "title": "Get started with Complexity Guard",
                "description": "Learn how to read the grades, Big-O estimates and suggestions in two minutes.",
                "steps": [
                    {
                        "id": "codecomplexity.step.open",
                        "title": "Open any function",
                        "description": "Open a Python, Java, JavaScript, TypeScript, Go, Rust, C, C++, C#, Ruby or PHP file. Every function gets a grade line above it.\n[Open the Complexity Report](command:codecomplexity.showReport)",
                        "media": {
                            "markdown": "media/walkthrough/step-open.md"
                        }
                    },
                    {
                        "id": "codecomplexity.step.read",
                        "title": "Read the numbers",
                        "description": "Cyclomatic = how many paths to test. Cognitive = how hard it is to follow. Big-O = how the run time grows with input size.\n[Explain the metrics](command:codecomplexity.explainMetrics)",
                        "media": {
                            "markdown": "media/walkthrough/step-read.md"
                        }
                    },
                    {
                        "id": "codecomplexity.step.fix",
                        "title": "Apply a suggestion",
                        "description": "Hover a yellow or red function, or press Ctrl+. on it, to see a concrete before/after fix.",
                        "media": {
                            "markdown": "media/walkthrough/step-fix.md"
                        }
                    },
                    {
                        "id": "codecomplexity.step.tune",
                        "title": "Tune it to your team",
                        "description": "Change thresholds, switch off CodeLens, or disable languages.\n[Open settings](command:codecomplexity.configureThreshold)",
                        "media": {
                            "markdown": "media/walkthrough/step-tune.md"
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "npm run typecheck && node esbuild.js --production",
        "compile": "tsc -p ./",
        "watch": "node esbuild.js --watch",
        "typecheck": "tsc -p ./ --noEmit",
        "pretest": "npm run compile && node esbuild.js",
        "test": "mocha \"out/test/unit/**/*.test.js\" --timeout 30000",
        "cli": "node dist/cli.js",
        "package": "vsce package",
        "publish": "vsce publish",
        "update-wasm": "node scripts/update-wasm.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^18.19.0",
        "@types/vscode": "^1.80.0",
        "@vscode/vsce": "^3.3.2",
        "esbuild": "^0.25.0",
        "mocha": "^11.7.5",
        "typescript": "^5.6.0"
    },
    "dependencies": {
        "web-tree-sitter": "0.27.0"
    }
}
