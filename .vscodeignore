# Everything is bundled into dist/ by esbuild; ship only what runs.
.vscode/**
.vscode-test/**
.github/**
src/**
test/**
out/**
scripts/**
node_modules/**
.gitignore
.gitattributes
.npmrc
.mocharc.json
tsconfig.json
esbuild.js
*.vsix
**/*.map

# Docs: keep README, CHANGELOG and LICENSE only.
docs/**
CONTRIBUTING.md
PUBLISHING_GUIDE.md

# Keep the bundle, the parsers and the UI assets.
!dist/extension.js
!dist/worker.js
!dist/cli.js
!wasm/**
!media/**
!icon.png
